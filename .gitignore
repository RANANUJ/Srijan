backend/node_modules/

# ─── Database ─────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Logs ─────────────────────────────────────────────
logs/
*.log
lerna-debug.log*

# ─── OS Files ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE / Editor ─────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── TypeScript ───────────────────────────────────────
*.tsbuildinfo

# ─── Test Coverage ────────────────────────────────────
coverage/
