# ─── Node.js ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Environment Variables (NEVER commit secrets) ─────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ─── Next.js Frontend ────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/

# ─── NestJS Backend ───────────────────────────────────
backend/dist/
backend/build/

# ─── Prisma ───────────────────────────────────────────
